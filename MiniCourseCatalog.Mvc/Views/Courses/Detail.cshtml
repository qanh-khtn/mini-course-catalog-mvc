@model CourseDetailViewModel
@{
    ViewData["Title"] = "Chi Tiết Khóa Học";
    var currentTheme = ViewData["Theme"]?.ToString() ?? "light";
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div><h2 class="page-title text-success fw-bold">Chi Tiết Lớp Học</h2><p class="page-description text-muted">Thông tin quản trị vận hành nội bộ của lớp học.</p></div>
    <a class="btn app-btn app-btn-ghost fw-bold px-4" asp-controller="Courses" asp-action="Index" asp-route-theme="@currentTheme"><i class="bi bi-arrow-left me-2"></i>Quay lại danh sách</a>
</div>

<div class="row">
    <div class="col-md-8">
        <table class="table table-bordered bg-white shadow-sm align-middle">
            <tr><th class="table-light" width="30%">Mã hệ thống (ID)</th><td>@Model.Id</td></tr>
            <tr><th class="table-light">Mã khóa học</th><td class="fw-bold text-primary">@Model.Code</td></tr>
            <tr><th class="table-light">Tên khóa học</th><td class="fw-bold">@Model.Name</td></tr>
            <tr><th class="table-light">Chuyên ngành học</th><td>@Model.Category</td></tr>
            <tr><th class="table-light">Giảng viên phụ trách</th><td class="fw-bold text-dark">@Model.Instructor</td></tr>
            <tr><th class="table-light">Mức học phí</th><td class="text-danger fw-bold">@Model.TuitionFeeText</td></tr>
            <tr><th class="table-light">Số học viên hiện tại</th><td>@Model.CurrentEnrollment học viên</td></tr>
            <tr><th class="table-light">Sức chứa tối đa</th><td>@Model.MaxCapacity học viên</td></tr>
            <tr><th class="table-light">Ngày khai giảng</th><td>@Model.StartDateText</td></tr>
            <tr><th class="table-light">Doanh thu thu được</th><td class="text-success fw-bold">@Model.TotalRevenueText</td></tr>
        </table>
    </div>
    <div class="col-md-4">
        <div class="card border-warning mb-3 shadow-sm bg-warning bg-opacity-10"><div class="card-body"><h5 class="card-title text-warning-dark fw-bold">Trạng thái lớp học</h5><p class="card-text fs-4 fw-bold">@Model.CourseStatus</p><small class="text-muted">@Model.OperationalSuggestion</small></div></div>
        <div class="card border-info mb-3 shadow-sm bg-info bg-opacity-10"><div class="card-body"><h5 class="card-title text-info-dark fw-bold">Doanh thu hiện tại</h5><p class="card-text fs-4 fw-bold text-primary">@Model.TotalRevenueText</p><small class="text-muted">Tính dựa trên số lượng học viên thực tế đã hoàn tất đóng học phí.</small></div></div>
    </div>
</div>
