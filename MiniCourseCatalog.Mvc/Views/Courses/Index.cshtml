@model CourseIndexViewModel
@{
    ViewData["Title"] = "Danh Mục Khóa Học";
    var currentTheme = Model.Theme;
    var nextTheme = currentTheme == "light" ? "dark" : "light";
    var btnText = currentTheme == "light" ? "Giao diện Tối" : "Giao diện Sáng";
    var themeIconClass = currentTheme == "light" ? "theme-icon-moon" : "theme-icon-sun";
}

<div class="container py-4 course-page">
    <div class="row align-items-center mb-4">
        <div class="col-md-7">
            <h2 class="fw-extrabold m-0" style="letter-spacing: -1px;">Danh Mục Khóa Học</h2>
            <p class="text-muted m-0 mt-1">Hệ thống quản lý thông tin giảng dạy và điều phối sĩ số lớp học trực quan.</p>
        </div>
        <div class="col-md-5 text-md-end mt-3 mt-md-0 d-flex justify-content-end align-items-center gap-3">
            <a href="/Courses?keyword=@Model.Keyword&category=@Model.Category&theme=@nextTheme" class="modern-theme-switch shadow-sm pointer" title="@btnText" data-theme-toggle data-next-theme="@nextTheme">
                <span class="switch-track @(currentTheme == "dark" ? "track-dark" : "track-light")">
                    <span class="switch-symbol switch-symbol-sun"></span>
                    <span class="switch-symbol switch-symbol-moon"></span>
                    <span class="switch-thumb @(currentTheme == "dark" ? "thumb-dark" : "thumb-light")">
                        <span class="switch-thumb-icon"></span>
                    </span>
                </span>
            </a>

            <a class="btn app-btn app-btn-primary shadow-sm fw-bold px-4 py-2" href="/Courses/Stats?theme=@currentTheme">
                <i class="bi bi-bar-chart-fill me-2"></i>Báo Cáo
            </a>
        </div>
    </div>

    <div class="card filter-panel shadow-sm rounded-4 mb-4">
        <div class="card-body p-3 p-md-4">
            <form method="get" action="/Courses" class="row g-3 align-items-end">
                <input type="hidden" name="theme" value="@currentTheme" />
                <div class="col-md-5">
                    <label class="form-label small fw-bold text-uppercase text-muted">Tìm kiếm</label>
                    <input class="form-control form-control-lg search-input" name="keyword" value="@Model.Keyword" placeholder="Tên khóa học, mã lớp, giảng viên..." />
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-bold text-uppercase text-muted">Chuyên ngành</label>
                    <select class="form-select form-select-lg search-input" name="category">
                        <option value="">Tất cả chuyên ngành</option>
                        @foreach (var category in Model.Categories)
                        {
                            <option value="@category" selected="@(Model.Category == category)">@category</option>
                        }
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button class="btn app-btn app-btn-primary flex-fill fw-bold" type="submit">Lọc</button>
                    <a class="btn app-btn app-btn-ghost fw-bold" href="/Courses?theme=@currentTheme">Xóa</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm rounded-4 overflow-hidden course-table-card">
        <div class="card-header py-3 border-bottom d-flex justify-content-between align-items-center">
            <span class="fw-bold text-uppercase small tracking-wider">Danh sách lớp học vận hành</span>
            <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2 fw-bold">@Model.Courses.Count/@Model.TotalCoursesBeforeFilter lớp</span>
        </div>
        @if (Model.Courses.Count == 0)
        {
            <div class="empty-state text-center p-5">
                <div class="display-6 fw-bold mb-2">Không tìm thấy khóa học</div>
                <p class="text-muted mb-4">Thử đổi từ khóa hoặc chọn lại chuyên ngành để xem dữ liệu phù hợp hơn.</p>
                <a class="btn app-btn app-btn-primary fw-bold" href="/Courses?theme=@currentTheme">Xem toàn bộ khóa học</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary small text-uppercase">
                        <tr>
                            <th class="ps-4">Mã lớp</th>
                            <th>Khóa Học</th>
                            <th>Chuyên Ngành</th>
                            <th>Giảng Viên</th>
                            <th>Học Phí</th>
                            <th width="15%">Sĩ Số Đăng Ký</th>
                            <th>Trạng Thái</th>
                            <th class="text-center pe-4">Hành Động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Courses)
                        {
                            double pct = Math.Round((double)item.CurrentEnrollment / item.MaxCapacity * 100);
                            <tr>
                                <td class="ps-4 fw-mono text-primary small">@item.Code</td>
                                <td>
                                    <div class="fw-bold text-dark">@item.Name</div>
                                </td>
                                <td><span class="badge bg-light text-dark border rounded-3 px-2 py-1">@item.Category</span></td>
                                <td class="text-muted fw-medium">@item.Instructor</td>
                                <td class="fw-bold text-dark">@item.TuitionFeeText</td>
                                <td>
                                    <div class="d-flex align-items-center justify-content-between mb-1 small text-muted">
                                        <span>@item.CurrentEnrollment/@item.MaxCapacity</span>
                                        <span>@pct%</span>
                                    </div>
                                    <div class="progress rounded-pill" style="height: 6px;">
                                        <div class="progress-bar @(pct >= 100 ? "bg-danger" : pct >= 80 ? "bg-warning" : "bg-success")" style="width: @pct%"></div>
                                    </div>
                                </td>
                                <td>
                                    <span class="@item.StatusClass px-3 py-1.5 rounded-pill font-semibold small">
                                        @item.CourseStatus
                                    </span>
                                </td>
                                <td class="text-center pe-4">
                                    <a class="btn btn-sm app-btn app-btn-ghost fw-bold" href="/Courses/Detail/@item.Id?theme=@currentTheme">
                                        Quản lý
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
