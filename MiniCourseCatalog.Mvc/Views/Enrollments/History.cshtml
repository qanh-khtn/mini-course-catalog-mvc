@model List<MiniCourseCatalog.Mvc.Models.Enrollment>
@{
    ViewData["Title"] = "Lịch Sử Đăng Ký";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Lịch Sử Đăng Ký Khóa Học</h2>
            <p class="text-muted">Danh sách toàn bộ lượt đăng ký — sử dụng <code>.Include()</code> + <code>.AsNoTracking()</code>.</p>
        </div>
        <a asp-controller="Courses" asp-action="Enroll" class="btn app-btn app-btn-primary fw-bold px-4">
            <i class="bi bi-person-plus me-2"></i>Đăng ký mới
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info rounded-4">Chưa có lượt đăng ký nào. Hãy thử <a asp-controller="Courses" asp-action="Enroll">đăng ký học viên</a>.</div>
    }
    else
    {
        <div class="card shadow-sm rounded-4 border-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Học viên</th>
                            <th>Khóa học</th>
                            <th>Chuyên ngành</th>
                            <th>Ngày đăng ký</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (item, index) in Model.Select((e, i) => (e, i + 1)))
                        {
                            <tr>
                                <td class="text-muted">@index</td>
                                <td>
                                    <strong>@item.Student.FullName</strong><br/>
                                    <small class="text-muted">@item.Student.Email</small>
                                </td>
                                <td>
                                    <span class="badge bg-primary-subtle text-primary me-1">@item.Course.Code</span>
                                    @item.Course.Name
                                </td>
                                <td><span class="badge bg-secondary-subtle text-secondary">@item.Course.CourseCategory.Name</span></td>
                                <td class="text-muted small">@item.EnrolledAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <p class="text-muted small mt-2">Tổng cộng: <strong>@Model.Count</strong> lượt đăng ký</p>
    }
</div>
