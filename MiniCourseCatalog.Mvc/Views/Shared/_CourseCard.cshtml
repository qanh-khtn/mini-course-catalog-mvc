@model CourseListItemViewModel

@{
    var theme = ViewData["Theme"]?.ToString() ?? "light";
}

<div class="card course-card h-100 rounded-4 shadow-sm">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
            <div>
                <div class="fw-bold text-primary small">@Model.Code</div>
                <h5 class="fw-bold mb-1">@Model.Name</h5>
                <div class="text-muted small">@Model.Category</div>
            </div>

            <partial name="~/Views/Courses/_CourseStatusBadge.cshtml" model="Model" />
        </div>

        <div class="small mb-2">
            <span class="text-muted">Giảng viên:</span>
            <span class="fw-bold">@Model.Instructor</span>
        </div>

        <div class="small mb-2">
            <span class="text-muted">Học phí:</span>
            <span class="fw-bold text-success">@Model.TuitionFeeText</span>
        </div>

        <div class="small mb-3">
            <span class="text-muted">Sĩ số:</span>
            <span class="fw-bold">@Model.EnrollmentStatus</span>
        </div>

        <a asp-controller="Courses"
           asp-action="Detail"
           asp-route-id="@Model.Id"
           asp-route-theme="@theme"
           class="btn app-btn app-btn-ghost fw-bold w-100">
            Xem chi tiết
        </a>
    </div>
</div>